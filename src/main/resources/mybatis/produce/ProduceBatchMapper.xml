<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.middle.wcs.produce.dao.ProduceBatchMapper">

    <resultMap type="com.middle.wcs.produce.entity.po.ProduceBatch" id="ProduceBatchMap">
        <id     property="id"          column="id"           jdbcType="BIGINT"/>
        <result property="batchNo"     column="batch_no"     jdbcType="VARCHAR"/>
        <result property="status"      column="status"       jdbcType="CHAR"/>
        <result property="invalidFlag" column="invalid_flag" jdbcType="CHAR"/>
        <result property="confirmTime" column="confirm_time" jdbcType="TIMESTAMP"/>
        <result property="finishTime"  column="finish_time"  jdbcType="TIMESTAMP"/>
        <result property="createdAt"   column="created_at"   jdbcType="TIMESTAMP"/>
    </resultMap>

    <select id="selectCurrentExecuting" resultMap="ProduceBatchMap">
        SELECT TOP 1 id, batch_no, status, invalid_flag, confirm_time, finish_time, created_at
        FROM dbo.produce_batch
        WHERE invalid_flag = '0'
          AND status IN ('1', '2')
        ORDER BY created_at DESC
    </select>

    <select id="countExecutingExcludeBatch" resultType="int">
        SELECT COUNT(1)
        FROM dbo.produce_batch
        WHERE invalid_flag = '0'
          AND status IN ('1', '2')
          <if test="excludeBatchId != null">
              AND id != #{excludeBatchId}
          </if>
    </select>

</mapper>
